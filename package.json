{
  "name": "ame-website",
  "version": "1.0.0",
  "description": "AME Website (Association of Mechanical Engineering) - Monorepo",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "seed:admin": "npm run seed:admin --prefix server",
    "test:server": "npm test --prefix server",
    "build:client": "npm run build --prefix client"
  },
  "keywords": [
    "ame",
    "mechanical-engineering",
    "mern",
    "vite",
    "react",
    "express"
  ],
  "author": "Ayush Mishra",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^10.0.7"
  }
}
